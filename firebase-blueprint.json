{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based details (farmers, buyers, admins)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier matching Firebase Auth UID" },
        "fullName": { "type": "string", "description": "Full display name of user" },
        "email": { "type": "string", "description": "User email address" },
        "role": { "type": "string", "enum": ["farmer", "fodder_supplier", "buyer", "admin"], "description": "Account role" },
        "phone": { "type": "string", "description": "Contact telephone number" },
        "avatar": { "type": "string", "description": "Profile picture URL" },
        "status": { "type": "string", "enum": ["active", "suspended", "pending_verification", "deleted"], "description": "User status" },
        "location": { "type": "object", "description": "Geographical location in Zimbabwe" },
        "farmerProfile": { "type": "object", "description": "Farm and producer details" },
        "buyerProfile": { "type": "object", "description": "Buyer preferences" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["uid", "fullName", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Farm produce and livestock marketplace listing",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Listing ID" },
        "farmerId": { "type": "string", "description": "Farmer account UID" },
        "name": { "type": "string", "description": "Produce item name" },
        "price": { "type": "number", "description": "Unit price in USD" },
        "unit": { "type": "string", "description": "Measuring unit" },
        "category": { "type": "string", "description": "Category identifier" },
        "quantityAvailable": { "type": "number", "description": "Available stock quantity" }
      },
      "required": ["farmerId", "name", "price", "unit"]
    },
    "Order": {
      "title": "Order",
      "description": "Produce purchase order between buyer and farmer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Order ID" },
        "buyerId": { "type": "string", "description": "Buyer UID" },
        "farmerId": { "type": "string", "description": "Farmer UID" },
        "totalAmount": { "type": "number", "description": "Total order amount" },
        "status": { "type": "string", "description": "Current order lifecycle status" },
        "completedAt": { "type": "string", "description": "Timestamp when order reached done status" },
        "isReviewed": { "type": "boolean", "description": "Whether buyer submitted an order rating" },
        "rating": { "type": "number", "description": "Submitted 1-5 star rating" },
        "reviewComment": { "type": "string", "description": "Optional buyer written review" },
        "ratedAt": { "type": "string", "description": "Timestamp when rating was submitted" }
      },
      "required": ["buyerId", "farmerId", "totalAmount", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Completed order rating and optional written review from buyer to farmer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Review ID" },
        "orderId": { "type": "string", "description": "Completed Order ID" },
        "orderNumber": { "type": "string", "description": "Human-readable order reference" },
        "buyerId": { "type": "string", "description": "Buyer UID" },
        "farmerId": { "type": "string", "description": "Farmer UID" },
        "rating": { "type": "number", "description": "Star rating (1 to 5)" },
        "ratingLabel": { "type": "string", "description": "Rating label e.g. 5 Stars – Excellent" },
        "comment": { "type": "string", "description": "Optional written review" },
        "createdAt": { "type": "string", "description": "Submission timestamp" }
      },
      "required": ["orderId", "buyerId", "farmerId", "rating"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Public community broadcasts, weather bulletins, logistics updates, and subsidies",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Announcement ID" },
        "title": { "type": "string", "description": "Headline of announcement" },
        "content": { "type": "string", "description": "Announcement body message" },
        "priority": { "type": "string", "enum": ["normal", "urgent"], "description": "Priority level" },
        "category": { "type": "string", "description": "Channel topic (platform, logistics, subsidy, weather, market_update, general)" },
        "targetAudience": { "type": "string", "enum": ["all", "farmers", "buyers"], "description": "Target user group" },
        "author": { "type": "string", "description": "Author name" },
        "authorRole": { "type": "string", "description": "Author role" },
        "pinned": { "type": "boolean", "description": "Whether pinned to top of channel" }
      },
      "required": ["title", "content"]
    },
    "MediaPost": {
      "title": "MediaPost",
      "description": "Farmer photos and videos showcased in the FarmBridge Community section",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Post ID" },
        "farmerId": { "type": "string", "description": "Farmer UID" },
        "caption": { "type": "string", "description": "Post caption" },
        "media": { "type": "array", "description": "Uploaded image and video items" },
        "likesCount": { "type": "number", "description": "Total likes count" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["farmerId", "caption", "media"]
    },
    "BuyerRequest": {
      "title": "BuyerRequest",
      "description": "Buyer sourcing request for agricultural produce or livestock",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Request ID" },
        "buyerId": { "type": "string", "description": "Buyer UID" },
        "productName": { "type": "string", "description": "Requested product or service" },
        "category": { "type": "string", "description": "Category ID" },
        "quantityRequired": { "type": "string", "description": "Required quantity" },
        "location": { "type": "string", "description": "Delivery or pickup location" },
        "status": { "type": "string", "enum": ["open", "in_discussion", "handled", "cancelled"], "description": "Request lifecycle status" }
      },
      "required": ["buyerId", "productName", "quantityRequired", "status"]
    },
    "DeletedAccount": {
      "title": "DeletedAccount",
      "description": "Tombstone record for permanently deleted or spam-removed accounts to prevent re-login",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Deleted user UID" },
        "email": { "type": "string", "description": "Original email address" },
        "emailLower": { "type": "string", "description": "Lowercase normalized email for lookup" },
        "deletedBy": { "type": "string", "description": "Admin ID or self" },
        "reason": { "type": "string", "description": "Deletion reason" },
        "deletedAt": { "type": "string", "description": "Deletion timestamp" }
      },
      "required": ["uid"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and registration signups collection"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Marketplace produce listings"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Direct farm purchases and transactions"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Community broadcast and bulletin announcements channel"
    },
    "/mediaPosts/{postId}": {
      "schema": "MediaPost",
      "description": "FarmBridge Community farmer media showcase posts"
    },
    "/buyerRequests/{requestId}": {
      "schema": "BuyerRequest",
      "description": "Buyer product sourcing requests"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Completed order buyer ratings and optional written reviews"
    },
    "/deletedAccounts/{userId}": {
      "schema": "DeletedAccount",
      "description": "Tombstones for deleted user and spam accounts"
    }
  }
}
