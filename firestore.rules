rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profiles collection
    match /users/{userId} {
      allow read: if true;
      allow create, delete: if true;
      // Non-admin Firebase-authenticated users cannot mutate locked identity fields (fullName, name, phone, role)
      allow update: if (
        request.auth == null ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fullName', 'name', 'phone', 'role'])
      );
    }

    // Product listings collection
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Orders collection
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Direct Messages & Conversations
    match /conversations/{conversationId} {
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, create, write: if true;
      }
    }

    // Order & product ratings (immutable once submitted so farmers cannot modify or delete ratings)
    match /reviews/{reviewId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Community Broadcast & Bulletin Announcements Channel
    match /announcements/{announcementId} {
      allow read, create, update, delete: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, create, update, delete: if true;
    }

    // Farmer Advertisements & Hot Deals
    match /adRequests/{adId} {
      allow read, create, update, delete: if true;
    }

    // FarmBridge Community Farmer Media Posts
    match /mediaPosts/{postId} {
      allow read, create, update, delete: if true;
    }

    // Buyer Product Requests
    match /buyerRequests/{requestId} {
      allow read, create, update, delete: if true;
    }

    // Deleted account tombstones (prevents deleted spam accounts from re-entering)
    match /deletedAccounts/{userId} {
      allow read, create, update, delete: if true;
    }

    // Protected account update support requests
    match /supportRequests/{requestId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Immutable admin audit trail for farmer edits and support resolutions
    match /adminAuditLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}
